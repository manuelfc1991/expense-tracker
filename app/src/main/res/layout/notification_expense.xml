<?xml version="1.0" encoding="utf-8"?>
<!--
  The expense notification, drawn to look like the app rather than like Android.

  RemoteViews, because a notification is inflated by the system process and cannot use
  Compose. That constrains the vocabulary to a handful of classic views — which is fine,
  since this layout is a caption, a figure and a rule, and those are the three things
  every screen in this app is made of.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/notif_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <!-- Small caps over the value, never beside it: the eye lands on the figure and
         reads the caption only if it needs to. -->
    <TextView
        android:id="@+id/notif_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:letterSpacing="0.16"
        android:textAllCaps="true"
        android:fontFamily="@font/ours_mono_medium"
        android:textColor="@color/notif_dim"
        android:text="@string/notif_new_expense" />

    <TextView
        android:id="@+id/notif_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="27sp"
        android:fontFamily="@font/ours_mono_bold"
        android:textColor="@color/notif_text"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notif_merchant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="13sp"
        android:textColor="@color/notif_text"
        android:maxLines="1"
        android:ellipsize="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/notif_hair" />

    <TextView
        android:id="@+id/notif_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:textSize="9sp"
        android:letterSpacing="0.16"
        android:textAllCaps="true"
        android:fontFamily="@font/ours_mono_medium"
        android:textColor="@color/notif_accent"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
