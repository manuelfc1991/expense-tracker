<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-bleed 108x108. The launcher mask only reveals the centre 72x72 and may crop to
  a circle, squircle or teardrop depending on the phone, so the background carries no
  detail — just the app's hero gradient so the icon and the home screen agree.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF4C3BCF" />
                <item android:offset="0.55" android:color="#FF6C3AD8" />
                <item android:offset="1.0" android:color="#FF8A2FC4" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
