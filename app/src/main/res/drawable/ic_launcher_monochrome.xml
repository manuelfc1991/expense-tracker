<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon variant (Android 13+). The launcher tints this a single colour, so it
  needs its own copy: the mint lens in the full-colour mark would flatten into the
  same tone as the rings and the shape would read as one blob. Here the lens stays
  solid while the rings stay outlined, which survives being reduced to one colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="?attr/colorControlNormal">

    <path
        android:pathData="M54,41.64 A15,15 0 0,0 54,66.36 A15,15 0 0,0 54,41.64 Z"
        android:fillColor="#FF000000" />

    <path
        android:pathData="M45.5,39 a15,15 0 1,0 0,30 a15,15 0 1,0 0,-30"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:fillColor="#00000000" />

    <path
        android:pathData="M62.5,39 a15,15 0 1,0 0,30 a15,15 0 1,0 0,-30"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:fillColor="#00000000" />
</vector>
